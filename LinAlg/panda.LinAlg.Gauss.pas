unit panda.LinAlg.Gauss;

interface

uses
    panda.Intfs
  , panda.LinAlg.Base
  ;

type
  TGaussTolerance = panda.LinAlg.Base.TGaussTolerance;

  /// <summary>
  ///   Gaussian elimination with arithmetic and pivot selection supplied by
  ///   descendants. Copies retain managed values and workspaces use the
  ///   descendant's mathematical zero rather than assuming Default(T) is zero.
  ///   Returned arrays retain their values independently of the solver lifetime.
  ///   For homogeneous systems the particular solution is zero. Otherwise free
  ///   variables of the particular solution are set to one. Arithmetic and
  ///   allocation exceptions propagate; square elimination costs O(N^3).
  /// </summary>
  TGaussElim<T> = class abstract(TLinAlgBase<T>)
  public type
    PT = TLinAlgBase<T>.PT;
  protected
    fIsHomogenous: Boolean;
    fInitialized: Boolean;
    procedure BackSubstitute(const aFreeIdxs: TArray<NativeInt>; aFreeCnt, aRank: NativeInt;
      aSol: TArray<T>; aUpperBW: NativeInt = -1);
  public
    /// <summary>Creates the numerical provider and leaves the solver uninitialized.</summary>
    procedure AfterConstruction; override;
    /// <summary>
    ///   Copies <c>aA</c> and appends <c>ab</c> as the last column.
    ///   Returns <c>False</c> when <c>aA</c> has no rows or no columns, when its
    ///   rows differ in length, or when <c>ab</c> length differs from the row count.
    /// </summary>
    /// <param name="ab">
    ///   Right-hand side; nil selects a homogeneous system.
    /// </param>
    function Init(const aA: TArray<TArray<T>>; const ab: TArray<T> = nil): Boolean; overload;
    /// <summary>
    ///   Copies <c>aA</c> and appends <c>ab</c> as the last column.
    ///   <c>ab</c> nil selects a homogeneous system. Any 2D layout is copied.
    ///   Returns <c>False</c> when <c>aA</c> has no columns.
    /// </summary>
    function Init(const aA: INDArray<T>; const ab: INDArray<T> = nil): Boolean; overload;
    /// <summary>
    ///   Initialize solver by equation system's matrix that is extended by the
    ///   right side. Data will be changed during the calculation. Row references
    ///   stay in place; pivot order exists only in the solver's row pointers.
    ///   The column count must be the row count plus one.
    /// </summary>
    function InitWithoutCopy(const aA: TArray<TArray<T>>): Boolean; overload;
    /// <summary>
    ///   Aliases an augmented matrix whose column count is the row count plus one.
    ///   The array is changed during the calculation. Its rows stay at their
    ///   original addresses; pivot order exists only in the solver's row pointers.
    ///   The matrix must be writable and its column stride must be <c>SizeOf(T)</c>.
    /// </summary>
    function InitWithoutCopy(const aA: INDArray<T>): Boolean; overload;
    /// <summary>
    ///   Solves the system set by <c>Init</c> or <c>InitWithoutCopy</c>.
    ///   Both results are empty when the solver is not initialized or the system
    ///   has no solution. The solver must be initialized again before the next call.
    /// </summary>
    /// <param name="aPartRes">
    ///   Particular result (is solution of the equations system with the right
    ///   side).
    /// </param>
    /// <param name="aHomRes">
    ///   Solution of the homogenous equations system. This solution is a vector
    ///   space that is generated by the vectors that are contained in the
    ///   <c>aHomRes</c> parameter.
    /// </param>
    procedure Solve(out aPartRes: TArray<T>; out aHomRes: TArray<TArray<T>>);
  end;

implementation

uses
    panda.Arrays
  ;

{$POINTERMATH ON}

procedure TGaussElim<T>.AfterConstruction;
begin
  inherited;
  fIsHomogenous := True;
  fInitialized := False;
end;

function TGaussElim<T>.Init(const aA: TArray<TArray<T>>; const ab: TArray<T>): Boolean;
var R, C, I: Integer;
    v: T;
begin
  fInitialized := False;
  fIsHomogenous := True;
  ClearAnchors;

  R := Length(aA);
  if R = 0 then exit(False);
  if (ab <> nil) and (R <> Length(ab)) then exit(False); //size mishmach
  C := Length(aA[0]);
  if C = 0 then exit(False);
  for I := 0 to R - 1 do
    if Length(aA[I]) <> C then exit(False); // A is not a matrix

  fWidth := C + 1;
  SetLength(fBuf, R * fWidth);
  SetLength(fRows, R);
  v := fNumeric.Zero;
  for I := 0 to R - 1 do begin
    fRows[I] := @fBuf[I * fWidth];
    TNDAUt.Copy<T>(PByte(@aA[I, 0]), PByte(fRows[I]), C);
    if ab <> nil then v := ab[I];
    fIsHomogenous := fIsHomogenous and fNumeric.IsZeroValue(v);
    fRows[I][C] := v;
  end;

  fInitialized := True;
  Result := fInitialized;
end;

function TGaussElim<T>.Init(const aA: INDArray<T>; const ab: INDArray<T>): Boolean;
var spec: TMatSpec;
    R, C, I: Integer;
    v: T;
    pRow, pB: PByte;
    bStep: NativeInt;
begin
  fInitialized := False;
  fIsHomogenous := True;
  ClearAnchors;

  if not NDMatrix(aA, spec) then exit(False);
  R := spec.NRows;
  C := spec.NCols;
  if C = 0 then exit(False);

  pB := nil;
  bStep := 0;
  if ab <> nil then begin
    if not VectorQ(ab) or (ab.Size <> R) then exit(False);
    pB := ab.Data;
    bStep := ab.Strides[0];
  end;

  fWidth := C + 1;
  SetLength(fBuf, R * fWidth);
  SetLength(fRows, R);

  pRow := spec.Data;
  v := fNumeric.Zero;
  for I := 0 to R - 1 do begin
    fRows[I] := @fBuf[I * fWidth];
    TNDAUt.Copy<T>(pRow, PByte(fRows[I]), C, spec.CStep);
    if ab <> nil then begin
      v := PT(pB)^;
      Inc(pB, bStep);
    end;
    fIsHomogenous := fIsHomogenous and fNumeric.IsZeroValue(v);
    fRows[I][C] := v;
    Inc(pRow, spec.RStep);
  end;

  fInitialized := True;
  Result := True;
end;

function TGaussElim<T>.InitWithoutCopy(const aA: TArray<TArray<T>>): Boolean;
var I: Integer;
begin
  Result := False;
  fInitialized := False;
  fIsHomogenous := True;
  if not BindDyn(aA) then exit;

  if fWidth <> Length(fRows) + 1 then begin
    ClearAnchors;
    exit;
  end;

  for I := 0 to High(fRows) do
    fIsHomogenous := fIsHomogenous and fNumeric.IsZeroValue(fRows[I][fWidth - 1]);
  fInitialized := True;
  Result := True;
end;

function TGaussElim<T>.InitWithoutCopy(const aA: INDArray<T>): Boolean;
var I: Integer;
begin
  Result := False;
  fInitialized := False;
  fIsHomogenous := True;
  if not AliasND(aA, True) then exit;

  for I := 0 to High(fRows) do
    fIsHomogenous := fIsHomogenous and fNumeric.IsZeroValue(fRows[I][fWidth - 1]);
  fInitialized := True;
  Result := True;
end;

procedure TGaussElim<T>.BackSubstitute(const aFreeIdxs: TArray<NativeInt>;
  aFreeCnt, aRank: NativeInt; aSol: TArray<T>; aUpperBW: NativeInt);
var I, K, iMax, C, count: NativeInt;
    tmp: T;
begin
  C := fWidth - 1;
  iMax := aFreeCnt - 1;
  K := aRank - 1;
  if (iMax >= 0) and (C - 1 = aFreeIdxs[iMax]) then
    Dec(iMax)
  else begin
    aSol[C - 1] := fNumeric.Divide(fRows[K][C], fRows[K][C - 1]);
    Dec(K);
  end;

  for I := C - 2 downto 0 do
    if (iMax >= 0) and (I = aFreeIdxs[iMax]) then
      Dec(iMax)
    else begin
      count := C - I - 1;
      if (aUpperBW >= 0) and (aUpperBW < count) then
        count := aUpperBW;
      fNumeric.Dot(fRows[K] + (I + 1), @aSol[I + 1], count, tmp);
      aSol[I] := fNumeric.SubDiv(fRows[K][C], tmp, fRows[K][I]);
      Dec(K);
    end;
end;

procedure TGaussElim<T>.Solve(out aPartRes: TArray<T>; out aHomRes: TArray<TArray<T>>);
var I, iMax, R, C, cIdx, rIdx, top, lower, upper, lastRow, lastCol: NativeInt;
    freeIdxs: TArray<NativeInt>;
    factor, v, z, s: T;
begin
  aPartRes := nil;
  aHomRes := nil;

  if not fInitialized then exit;

  try
    R := Length(fRows);
    C := fWidth - 1;
    SetLength(freeIdxs, C);
    top := 0;
    cIdx := 0;
    rIdx := 0;
    if R = C then
      GetBandWidths(C, lower, upper)
    else begin
      lower := R - 1;
      upper := C - 1;
    end;
    fNumeric.PrepareTolerance(fRows, C, True);

    while (cIdx < C) and (rIdx < R) do begin
      lastRow := R - 1;
      if lower < lastRow - rIdx then
        lastRow := rIdx + lower;
      iMax := fNumeric.ArgMax(fRows, rIdx, cIdx, lastRow);
      if fNumeric.IsZeroTol(fRows[iMax][cIdx]) then begin
        // Row and column indices diverge after a skipped pivot. Continue dense.
        lower := R - 1;
        upper := C - 1;
        freeIdxs[top] := cIdx;
        Inc(top);
        Inc(cIdx);
        continue;
      end;
      SwapPivot(rIdx, iMax);
      lastCol := C - 1;
      if upper < lastCol - cIdx then
        lastCol := cIdx + upper;
      v := fNumeric.Zero;
      s := fRows[rIdx][cIdx];
      if lastCol = C - 1 then begin
        for I := rIdx + 1 to lastRow do begin
          factor := fNumeric.NegDiv(fRows[I][cIdx], s);
          fNumeric.Axpy(factor, fRows[rIdx] + cIdx + 1, fRows[I] + cIdx + 1, C - cIdx);
          fRows[I][cIdx] := v;
        end
      end else begin
        for I := rIdx + 1 to lastRow do begin
          factor := fNumeric.NegDiv(fRows[I][cIdx], s);
          fNumeric.Axpy(factor, fRows[rIdx] + cIdx + 1, fRows[I] + cIdx + 1, lastCol - cIdx);
          fNumeric.Axpy(factor, fRows[rIdx] + C, fRows[I] + C, 1);
          fRows[I][cIdx] := v;
        end
      end;
      Inc(rIdx);
      Inc(cIdx);
    end;

    while cIdx < C do begin
      freeIdxs[top] := cIdx;
      Inc(top);
      Inc(cIdx);
    end;

    //check rank
    for I := rIdx to R - 1 do
      if not fNumeric.IsZeroRHSTol(fRows[I][C]) then
        exit; //There is no solution: h(A) <> h((A|b))

    SetLength(aPartRes, C);
    FillZero(aPartRes);
    v := fNumeric.One;
    if not fIsHomogenous then begin
      // calculate particular solution
      for I := 0 to top - 1 do
        aPartRes[freeIdxs[I]] := v;
      BackSubstitute(freeIdxs, top, rIdx, aPartRes, upper);
    end;

    //calculate solution of the homogenous system
    if top > 0 then begin
      SetLength(aHomRes, top);
      if not fIsHomogenous then begin
        z := fNumeric.Zero;
        for I := 0 to R - 1 do
          fRows[I][C] := z; //set b vector to zero
      end;
      for I := 0 to top - 1 do begin
        SetLength(aHomRes[I], C);
        FillZero(aHomRes[I]);
        aHomRes[I, freeIdxs[I]] := v;
        BackSubstitute(freeIdxs, top, rIdx, aHomRes[I], upper);
      end;
    end;
  finally
    fInitialized := False;
  end;
end;

end.
